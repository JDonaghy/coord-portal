{
  "name": "coord-portal",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Customer intake and design sign-off portal for a claude-coordinator fleet",
  "license": "MIT",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.e2e.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "serve:test": "wrangler d1 migrations apply coord-portal --local && wrangler dev --port 8788",
    "db:migrate:local": "wrangler d1 migrations apply coord-portal --local",
    "db:migrate:remote": "wrangler d1 migrations apply coord-portal --remote",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260801.1",
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.0.0"
  }
}
